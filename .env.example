# Переменные окружения для локального запуска poibot.
# Скопируйте этот файл в `.env` и заполните значения (`.env` в git не попадает).

# --- Telegram ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Username бота без @ (например, my_poi_bot)
TELEGRAM_BOT_NAME=

# --- PostgreSQL (по умолчанию совпадает с compose.yaml) ---
PG_URL=jdbc:postgresql://localhost:5432/poi_bot
PG_USER=postgres
PG_PASSWORD=postgres

# --- Необязательно ---
# Порт HTTP-сервера (actuator), по умолчанию 8080
USE_PORT=8080