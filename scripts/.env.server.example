# Файл окружения бота на сервере: ~/poibot/.env (в git не попадает, права 600).
# Формат docker --env-file: KEY=VALUE без кавычек и без пробелов вокруг "=".

# Токен бота и username бота (без @) — от @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=

# Существующая PostgreSQL на сервере. Контейнер работает в сети хоста (как остальные), поэтому localhost.
# Схема poi_bot задаётся параметром currentSchema и должна быть создана заранее (docs/DEPLOY.md, раздел 1.2).
PG_URL=jdbc:postgresql://localhost:5432/<имя_БД>?currentSchema=poi_bot
PG_USER=
PG_PASSWORD=

# Необязательно. Порт приложения (actuator): слушает только 127.0.0.1, по умолчанию 8091.
# Должен быть свободен (ss -ltnp | grep :8091) и отличаться от портов других сервисов.
# USE_PORT=8091
